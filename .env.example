# VulnScope Platform Configuration
# Note: Never commit secrets or actual API keys. Copy this file to .env.local for local overrides.

# Optional: LLM Provider for Agentic Security Planner
# If left empty, VulnScope runs in fully functional, auditable Deterministic Adaptive Rule-Based Planner mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Or Google Gemini Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Maximum Upload File Size in Bytes (default: 4294967296 = 4 GB)
MAX_APK_SIZE_BYTES=4294967296

# Large APK uploads on Vercel (optional locally)
# Vercel functions reject request bodies above ~4.5 MB. Connect a Vercel Blob store to the project
# (Vercel dashboard > Storage > Create > Blob > Connect) and Vercel sets this token automatically;
# the upload screen then sends every APK straight to Blob storage, where it is kept permanently.
# Locally (no token) every APK is kept in storage/apks/.
BLOB_READ_WRITE_TOKEN=
# Access mode of the Blob store: private (default, recommended: kept apps are not publicly downloadable) or public.
# Must match how the store was created.
BLOB_ACCESS=private

# Action Execution Timeout (ms per action step, default: 15000 = 15s)
AGENT_ACTION_TIMEOUT_MS=15000

# Maximum Agent Planning Steps per Session (default: 8)
AGENT_MAX_STEPS=8

# Local Session Storage Directory (internal server-side path)
VULNSCOPE_STORAGE_DIR=.vulnscope

