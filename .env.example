# VulnCope Platform Configuration
# Note: Never commit secrets or actual API keys. Copy this file to .env.local for local overrides.

# Optional: LLM Provider for Agentic Security Planner
# If left empty, VulnCope runs in fully functional, auditable Deterministic Adaptive Rule-Based Planner mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Or Google Gemini Provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Maximum Upload File Size in Bytes (default: 104857600 = 100MB)
MAX_APK_SIZE_BYTES=104857600

# Action Execution Timeout (ms per action step, default: 15000 = 15s)
AGENT_ACTION_TIMEOUT_MS=15000

# Maximum Agent Planning Steps per Session (default: 8)
AGENT_MAX_STEPS=8

# Local Session Storage Directory (internal server-side path)
VULNCOPE_STORAGE_DIR=.vulncope
